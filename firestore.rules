rules_version = '2';

// Müşterek Mekanlar — Firestore güvenlik kuralları
// Firebase konsolu → Firestore Database → Rules sekmesine bu dosyanın tamamını yapıştırıp Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() { return request.auth != null; }

    // Siteyi yalnızca arkadaş grubuna kapatmak için: aşağıdaki listeyi doldur ve
    // `uye()` fonksiyonunun dönüşünü `girisli() && request.auth.token.email in [...]` yap.
    function uye() {
      return girisli();
      // return girisli() && request.auth.token.email in ['a@gmail.com', 'b@gmail.com'];
    }

    function kendiYeni() { return uye() && request.resource.data.yazarUid == request.auth.uid; }
    function kendisi()   { return uye() && resource.data.yazarUid == request.auth.uid; }

    // Giriş yapan herkesin adı ve fotoğrafı ("Kimler vardı" listesi). Herkes yalnızca kendini yazar.
    match /kisiler/{uid} {
      allow read: if uye();
      allow write: if uye() && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['ad', 'foto', 'son']);
    }

    match /anilar/{id} {
      allow read: if uye();
      allow create: if kendiYeni()
                    && request.resource.data.mekan is string
                    && request.resource.data.masa is int
                    && request.resource.data.metin is string
                    && request.resource.data.metin.size() <= 2000
                    && request.resource.data.fotolar is list
                    && request.resource.data.fotolar.size() <= 12;
      allow update: if kendisi() && request.resource.data.yazarUid == resource.data.yazarUid;
      allow delete: if kendisi();
    }

    match /yorumlar/{id} {
      allow read: if uye();
      allow create: if kendiYeni()
                    && request.resource.data.metin is string
                    && request.resource.data.metin.size() <= 600;
      allow delete: if kendisi();
    }

    // Sıkıştırılmış fotoğraflar (JPEG data URL), her biri ayrı belge.
    match /fotolar/{id} {
      allow read: if uye();
      allow create: if kendiYeni()
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 950000;
      allow delete: if kendisi();
    }
  }
}
